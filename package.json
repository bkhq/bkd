{
  "name": "@bkd/root",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "jittered-fractional-indexing": "^1.0.1",
      "typescript": "^7.0.2",
      "zod": "^4.5.4"
    }
  },
  "scripts": {
    "dev": "bun --env-file=.env run --filter @bkd/api --filter @bkd/frontend dev",
    "dev:api": "bun --filter @bkd/api dev",
    "dev:frontend": "bun --filter @bkd/frontend dev",
    "build": "bun --filter @bkd/frontend build",
    "start": "bun --filter @bkd/api start",
    "test": "bun --parallel --filter '*' test",
    "test:api": "bun --filter @bkd/api test",
    "test:frontend": "bun --filter @bkd/frontend test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "format:check": "eslint . --fix-dry-run",
    "db:generate": "bun --filter @bkd/api db:generate",
    "db:migrate": "bun --filter @bkd/api db:migrate",
    "db:reset": "bun apps/api/src/db/reset.ts",
    "clean": "bash ./scripts/clean.sh",
    "package": "bun scripts/package.ts"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@bkd/tsconfig": "workspace:*",
    "@dotns/nsl": "^0.2.1",
    "@eslint-react/eslint-plugin": "^5.19.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "typescript": "^6.0.3"
  }
}
