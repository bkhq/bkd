graph TB
    subgraph 入口["入口"]
        PROJECT["📂 项目首页<br/>看项目卡片、最近更新"]
    end

    subgraph 操作层["操作层"]
        CMD["🗣 指挥室<br/>────────<br/>@issue 追问/派发<br/>@外部Issue 同步<br/>秘书自动汇总<br/>阻塞事件冒泡<br/>对话即操作"]

        GANTT["📊 甘特图<br/>────────<br/>纵向: 父子链路<br/>横向: 时间进度<br/>🟢 正常 🟡 卡慢 🔴 阻塞<br/>按需深入 issue"]

        KANBAN["📋 看板<br/>────────<br/>横向看状态分布<br/>拖拽改状态<br/>批量操作<br/>快速一览"]
    end

    subgraph 底层["AI 操作"]
        SUB["🤖 子 agent 池<br/>────────<br/>自动执行<br/>自主修复<br/>失败升级"]
    end

    PROJECT --> CMD
    PROJECT --> GANTT
    PROJECT --> KANBAN

    CMD -- "@触发/派发/追问" --> SUB
    GANTT -- "看到阻塞 → 点进去 →" --> CMD
    KANBAN -- "看到卡住 → 点进去 →" --> CMD

    SUB -- "完成/卡住/进度" --> GANTT
    SUB -- "阻塞冒泡(修不好)" --> CMD
    SUB -- "状态变更" --> KANBAN

    style CMD fill:#e3f2fd,stroke:#1565c0,stroke-width:2px
    style GANTT fill:#e8f5e9,stroke:#2e7d32,stroke-width:2px
    style KANBAN fill:#fff3e0,stroke:#ef6c00,stroke-width:2px
    style SUB fill:#f3e5f5,stroke:#7b1fa2,stroke-width:1px,stroke-dasharray:5
    style PROJECT fill:#f5f5f5,stroke:#616161,stroke-width:1px
