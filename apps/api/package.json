{
  "name": "@bkd/api",
  "type": "module",
  "version": "0.0.6",
  "private": true,
  "description": "Backend API for the Bitk workspace.",
  "homepage": "https://github.com/bkhq",
  "repository": {
    "type": "git",
    "url": "https://github.com/bkhq/bkd.git",
    "directory": "apps/api"
  },
  "module": "src/index.ts",
  "scripts": {
    "dev": "nsl run --name bkd:/api bun --env-file=../../.env --hot src/index.ts",
    "start": "NODE_ENV=production bun src/index.ts",
    "test": "bun test --preload ./test/preload.ts test/",
    "test:watch": "bun test --preload ./test/preload.ts --watch test/",
    "db:generate": "bunx drizzle-kit generate",
    "db:migrate": "bunx drizzle-kit migrate",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@hono/zod-validator": "^0.9.1",
    "bs58": "^6.0.0",
    "consola": "^3.4.2",
    "cronbake": "^0.4.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.7",
    "jittered-fractional-indexing": "catalog:",
    "nanoid": "^6.0.1",
    "pino": "^10.3.1",
    "ulid": "^3.0.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@bkd/tsconfig": "workspace:*",
    "@libsql/client": "^0.18.0",
    "@types/bun": "^1.4.2",
    "drizzle-kit": "^0.31.10",
    "typescript": "catalog:"
  }
}
